# ==============================================
# CONFIGURAÇÃO DE PRODUÇÃO - PORTAL TI
# ==============================================
# ATENÇÃO: Copie este arquivo para .env e preencha com valores reais
# NUNCA commite o arquivo .env com senhas reais!

# ==============================================
# BANCO DE DADOS
# ==============================================
DB_PASSWORD=COLOQUE_UMA_SENHA_FORTE_AQUI

# ==============================================
# SEGURANÇA - JWT (OBRIGATÓRIO MUDAR!)
# ==============================================
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GERE_UM_SECRET_DE_32_CARACTERES_AQUI
JWT_REFRESH_SECRET=GERE_OUTRO_SECRET_DIFERENTE_AQUI

# ==============================================
# DOMÍNIO E CORS
# ==============================================
CORS_ORIGIN=https://seu-dominio.com
VITE_API_URL=https://api.seu-dominio.com
VITE_WS_URL=https://api.seu-dominio.com

# ==============================================
# EMAIL (Microsoft Graph)
# ==============================================
EMAIL_PROVIDER=graph
EMAIL_ENABLED=true

# App Registration (Entra ID) com permissao Mail.Send
# do tipo APLICATIVO + consentimento do administrador.
AZURE_TENANT_ID=seu-tenant-id
AZURE_CLIENT_ID=seu-client-id
AZURE_CLIENT_SECRET=seu-client-secret

# Caixa compartilhada do sistema - apenas o endereco,
# nunca no formato "Nome <email@dominio>".
EMAIL_FROM=portalti@opequenonazareno.org.br
EMAIL_FROM_NAME=Portal TI - O Pequeno Nazareno

# ==============================================
# OPCIONAL - Ajustes avançados
# ==============================================
# NODE_ENV=production
# PORT=3001
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_NAME=portal_ti
