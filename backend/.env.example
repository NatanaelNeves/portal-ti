# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=portal_ti

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-different-from-jwt
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# ============================================================
# EMAIL
# ============================================================
# Provedor: graph (Microsoft 365, em uso) | smtp (legado)
EMAIL_PROVIDER=graph
EMAIL_ENABLED=true

# --- Microsoft Graph (caminho oficial) ---
# Credenciais do App Registration no Entra ID.
# O app precisa da permissao Mail.Send do tipo APLICATIVO
# (nao "delegada") com consentimento do administrador.
AZURE_TENANT_ID=seu-tenant-id
AZURE_CLIENT_ID=seu-client-id
AZURE_CLIENT_SECRET=seu-client-secret

# Caixa compartilhada do sistema. ATENCAO: apenas o endereco,
# NUNCA no formato "Nome <email@dominio>" -- este valor entra
# direto na URL da chamada ao Graph (/users/{EMAIL_FROM}/sendMail)
# e o formato com nome quebra o envio. O nome vai em EMAIL_FROM_NAME.
EMAIL_FROM=portalti@opequenonazareno.org.br
EMAIL_FROM_NAME=Portal TI - O Pequeno Nazareno

# --- SMTP (legado, so se EMAIL_PROVIDER=smtp) ---
# O backend aceita EMAIL_* e tambem SMTP_* como alias.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=portalti@opequenonazareno.org.br
# SMTP_PASSWORD=sua-senha-ou-app-password
# SMTP_FROM=Portal TI <portalti@opequenonazareno.org.br>
# SMTP_ENABLED=true

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=./uploads

# WebSocket Configuration  
SOCKET_IO_CORS_ORIGIN=http://localhost:3000
